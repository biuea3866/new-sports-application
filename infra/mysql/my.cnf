# infra/mysql/my.cnf — MySQL 8.0 런타임 설정 (W1-02)
#
# 근거: 아키텍트 실행설계 §7-6 — 목표 구성(10 인스턴스 × 커넥션 풀 40 = 400)이 MySQL 기본
# max_connections(151)을 초과한다. 풀 크기 배분 자체는 W1-03 소유이며, 이 파일은
# 서버측 상한만 400 + 여유 100 = 500으로 넉넉히 연다.
#
# 마운트: docker-compose.yml mysql 서비스에 /etc/mysql/conf.d/my.cnf 로 read-only 마운트.
# 롤백: 마운트 라인(docker-compose.yml)을 제거하면 MySQL 기본값(151)으로 즉시 복귀 — 스키마 변경 없음.
[mysqld]
max_connections = 500
