    },
    {
      "id": "presigned-unauthenticated",
      "method": "POST",
      "path": "/images/presigned-upload",
      "body": { "filename": "shadow-probe.png", "contentType": "image/png", "domain": "product" },
      "note": "토큰 없이 호출 — 401 오류 계약"
    }
  ]
