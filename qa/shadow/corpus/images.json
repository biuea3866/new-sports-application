    },
    {
      "id": "presigned-jpeg",
      "method": "POST",
      "path": "/images/presigned-upload",
      "auth": "user",
      "body": { "filename": "shadow-probe.jpg", "contentType": "image/jpeg", "domain": "product" }
    },
    {
      "id": "presigned-webp",
      "method": "POST",
      "path": "/images/presigned-upload",
      "auth": "user",
      "body": { "filename": "shadow-probe.webp", "contentType": "image/webp", "domain": "product" }
    },
    {
      "id": "presigned-disallowed-content-type",
      "method": "POST",
      "path": "/images/presigned-upload",
      "auth": "user",
      "body": { "filename": "shadow-probe.exe", "contentType": "application/x-msdownload", "domain": "product" },
      "note": "미허용 content-type — 4xx 오류 계약"
